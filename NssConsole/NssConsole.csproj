<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NssStream\NssStream.csproj" />
  </ItemGroup>

  <Target Name="EnsureNativeLibrary" BeforeTargets="Build"
          Condition="!Exists('../Native/build/win-x64/proxymap_nss.dll') AND
                     !Exists('../Native/build/win-x64/Release/proxymap_nss.dll') AND
                     !Exists('../Native/build/linux-x64/libproxymap_nss.so') AND
                     !Exists('../Native/build/osx-arm64/libproxymap_nss.dylib') AND
                     !Exists('../Native/build/osx-x64/libproxymap_nss.dylib')">
    <Warning Text="Native library not found in ../Native/build/&lt;rid&gt;. Run Native/build.ps1 -Rid win-x64 (Windows), Native/build.sh (Linux/macOS, RID auto-detected) first." />
  </Target>

</Project>
